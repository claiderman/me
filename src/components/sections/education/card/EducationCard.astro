---
import { CompactYearBadge } from "@yearBadge/index";

interface Props {
  institution: string;
  area: string;
  studyType: string;
  startYear: string | number;
  endYear?: string | number;
  url: string;
  score?: string;
  viewLabel?: string;
  presentLabel?: string;
  inLabel?: string;
}

const {
  institution,
  area,
  studyType,
  startYear,
  endYear,
  url,
  score,
  viewLabel = "Ver institución",
  presentLabel = "Actual",
  inLabel = "en",
} = Astro.props;
const isLanguage = area === "Inglés";
// Evita "Tecnólogo en Tecnólogo en ..." cuando el área ya incluye el tipo de estudio
const degreeText = area.toLowerCase().startsWith(studyType.toLowerCase())
  ? area
  : `${studyType} ${inLabel} ${area}`;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="card education-card">
  <div class="card-content education-card-content">
    <div class="card-header education-header">
      <h3>{institution}</h3>
      <CompactYearBadge
        startYear={startYear}
        endYear={endYear}
        showIcon={true}
        presentLabel={presentLabel}
      />
    </div>
    <p class="card-description education-degree">
      {isLanguage && (
        <>
          {studyType} <span class="language-level">{area}</span>
        </>
      )}
      {!isLanguage && degreeText}
    </p>
    {isLanguage && score && (
      <p class="language-score">
        <i class="fas fa-language"></i> {score}
      </p>
    )}
    <div class="card-indicator education-indicator">
      <i class="fas fa-external-link-alt"></i>
      <span>{viewLabel}</span>
    </div>
  </div>
</a>

<style>
  @import '@card/styles/cards.css';

  .education-degree {
    margin: 0 0 0.5rem 0;
    color: var(--secondary);
    font-size: 0.85rem;
  }

  .language-level {
    font-weight: 500;
    color: var(--primary);
  }

  .language-score {
    margin: 0 0 0.5rem 0;
    color: var(--secondary);
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
</style> 