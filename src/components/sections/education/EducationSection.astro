---
import { Accordion } from "@accordion/index";
import Section from "@sections/Section.astro";
import type { I18nTFunction } from "@types";
import getCVData from "@utils/cv";
import EducationCard from "./card/EducationCard.astro";

interface Props {
  t: I18nTFunction;
  locale: string;
}

const { t, locale } = Astro.props;
const cvData = await getCVData(locale);
const { education } = cvData;
const isEnglish = locale === "en";
const viewLabel = isEnglish ? "View institution" : "Ver institución";
const presentLabel = isEnglish ? "Present" : "Actual";
const inLabel = isEnglish ? "in" : "en";
---

<Section>
  <Accordion title={t('sections.education')} icon="fas fa-graduation-cap">
    <div class="cards-grid education-grid">
      {
        education.map(
          ({ institution, area, studyType, startDate, endDate, url, score }) => {
            const startYear = new Date(startDate).getFullYear();
            const endYear =
              endDate != null ? new Date(endDate).getFullYear() : presentLabel;

            return (
              <EducationCard
                institution={institution}
                area={area}
                studyType={studyType}
                startYear={startYear}
                endYear={endYear}
                url={url}
                score={score}
                viewLabel={viewLabel}
                presentLabel={presentLabel}
                inLabel={inLabel}
              />
            );
          }
        )
      }
    </div>
  </Accordion>
</Section>

<style>
  @import '@card/styles/cards.css';
</style>