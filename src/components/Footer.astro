---
import type { I18nTFunction } from "@types";
import type { Profile } from "@types/cv";

interface Props {
  t: I18nTFunction;
  locale: "es" | "en";
  name: string;
  label: string;
  email: string;
  profiles: Profile[];
}

const { t, locale, name, label, email, profiles } = Astro.props;
const linkedInUrl = profiles.find((profile) => profile.network === "LinkedIn")?.url;
const githubUrl = profiles.find((profile) => profile.network === "GitHub")?.url;
const year = new Date().getFullYear();
const homeUrl = `/me/${locale}/`;
const sectionLinks = [
  { id: "sobre-mi", label: t("navigation.profile") },
  { id: "experiencia", label: t("navigation.experience") },
  { id: "educacion", label: t("navigation.education") },
  { id: "habilidades", label: t("navigation.skills") },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href={homeUrl} aria-label={`${name} - ${t("navigation.home")}`}>
        <span aria-hidden="true">&lt;/&gt;</span>
      </a>
      <div>
        <p class="footer-name">{name}</p>
        <p class="footer-label">{label}</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label={t("aria.navigationMenu")}>
      <p class="footer-heading">{t("navigation.home")}</p>
      <a href={`${homeUrl}#inicio`}>{t("navigation.home")}</a>
      {sectionLinks.map((section) => <a href={`${homeUrl}#${section.id}`}>{section.label}</a>)}
    </nav>

    <div class="footer-contact">
      <p class="footer-heading">{t("hero.contact")}</p>
      <a href={`mailto:${email}`}>
        <i class="fas fa-envelope" aria-hidden="true"></i>
        <span>{email}</span>
      </a>
      {linkedInUrl && (
        <a href={linkedInUrl} target="_blank" rel="noreferrer">
          <i class="fab fa-linkedin" aria-hidden="true"></i>
          <span>LinkedIn</span>
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noreferrer">
          <i class="fab fa-github" aria-hidden="true"></i>
          <span>GitHub</span>
        </a>
      )}
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {year} {name}. {t("footer.rights")}.</span>
    <span class="footer-built-with">
      {t("footer.builtWith")} <strong>Astro</strong> <span aria-hidden="true">·</span> TypeScript
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-left: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-secondary);
    color: var(--text);
    width: calc(100% - 12rem);
    max-width: 980px;
    margin: 4rem auto 2rem;
    padding: 4.5rem 3rem 1.5rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(220px, 1.5fr) minmax(130px, 1fr) minmax(220px, 1fr);
    gap: 4rem;
    max-width: none;
    margin: 0 auto;
  }

  .footer-brand,
  .footer-contact a {
    display: flex;
    align-items: center;
  }

  .footer-brand {
    align-items: flex-start;
    gap: 1rem;
  }

  .footer-logo {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--primary);
    border-radius: 8px;
    color: var(--primary);
    font-family: "Roboto Mono", monospace;
    font-size: 0.9rem;
    font-weight: 700;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .footer-logo:hover {
    background: var(--primary);
    color: var(--text-on-dark);
  }

  .footer-name {
    color: var(--text);
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .footer-label {
    color: var(--secondary);
    font-size: 0.8rem;
    margin-top: 0.4rem;
    max-width: 22rem;
  }

  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .footer-heading {
    color: var(--text);
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.8rem;
    text-transform: uppercase;
  }

  .footer-nav a,
  .footer-contact a {
    color: var(--secondary);
    font-size: 0.85rem;
    gap: 0.5rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-contact a i {
    color: var(--primary);
    width: 1rem;
    text-align: center;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--primary);
    transform: translateX(3px);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: none;
    margin: 4rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--secondary);
    font-size: 0.75rem;
  }

  .footer-built-with {
    text-align: right;
  }

  .footer-built-with strong {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .site-footer {
      margin-top: 3rem;
      width: calc(100% - 3rem);
      padding: 3.5rem 1.5rem 1.5rem;
    }

    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 1.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 3rem;
    }

    .footer-built-with {
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .site-footer {
      width: calc(100% - 2rem);
      padding: 3rem 1rem 1.5rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
